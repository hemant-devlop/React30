import React, { useLayoutEffect, useRef, useState } from "react";

const Example = () => {
  const [btn, setBtn] = useState(0);
  const [indicator, setIndicator] = useState(null);

  const containerRef = useRef(null);
  const btnRef = useRef([]);

  useLayoutEffect(() => {
    const updateIndicator = () => {
      const selectedBtn = btnRef.current[btn];
      const container = containerRef.current;

      if (!selectedBtn || !container) return;

      const buttonRect = selectedBtn.getBoundingClientRect();
      const containerRect = container.getBoundingClientRect();

      setIndicator({
        left: buttonRect.left - containerRect.left,
        width: buttonRect.width,
      });
    };

    updateIndicator();

    const observer = new ResizeObserver(updateIndicator);

    if (containerRef.current) {
      observer.observe(containerRef.current);
    }

    if (btnRef.current[btn]) {
      observer.observe(btnRef.current[btn]);
    }

    return () => observer.disconnect();
  }, [btn]);

  return (
    <>
      <div
        ref={containerRef}
        className="bg-red-300 max-w-100 ms-50 flex *:flex-1 *:cursor-pointer *:text-center relative"
      >
        {indicator && (
          <div
            className="absolute top-0 bottom-0 z-0 bg-green-700 transition-[transform,width] duration-300 ease-in-out"
            style={{
              width: indicator.width,
              transform: `translateX(${indicator.left}px)`,
            }}
          />
        )}

        {[0, 1, 2].map((v) => (
          <div
            ref={(el) => (btnRef.current[v] = el)}
            className="relative z-10"
            onClick={() => setBtn(v)}
            key={v}
          >
            item{v}
          </div>
        ))}
      </div>

      <button className="bg-red-500 ms-60 my-10 border-2 rounded-sm h-10 w-20 text-white font-bold border-zinc-900">
        {btn}
      </button>
    </>
  );
};

export default Example;
